{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "description": "SentinelCore-MCP is a MCP server that provides an interface for interacting with AI Tools.",
  "name": "io.github.kylec69/SentinelCoreMCP",
  "version": "1.0.0",
  "packages": [
    {
      "registryType": "nuget",
      "identifier": "SentinelCoreMCP",
      "version": "1.0.0",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [],
      "environmentVariables": []
    },
    {
      "registryType": "nuget",
      "identifier": "SentinelCoreMCP",
      "version": "1.0.0",
      "transport": {
        "type": "streamable-http",
        "url": "http://localhost:5000/mcp"
      },
      "packageArguments": [],
      "environmentVariables": [
        {
          "name": "MCP_TRANSPORT_TYPE",
          "value": "http"
        },
        {
          "name": "SENTINELCOREMCP",
          "value": "http://localhost:5000"
        }
      ]
    }
  ],
  "repository": {
    "url": "https://github.com/kylec69/SentinelCore-MCP",
    "source": "github"
  }
}
